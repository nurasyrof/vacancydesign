---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobListItem from '../components/JobListItem.astro';
import JobDetailPanel from '../components/JobDetailPanel.astro';
import { getJobs, locationLabel, parseBlocks } from '../lib/jobs';

const jobs = await getJobs();
const jobCount = jobs.length;

const jobsData = jobs.map(j => ({
  id: j.id,
  companyName: j.companyName,
  roleTitle: j.roleTitle,
  employmentType: j.employmentType,
  location: locationLabel(j),
  summaryBlocks: parseBlocks(j.summary),
  responsibilities: j.responsibilities,
  requirements: j.requirements,
  applyUrl: j.applyUrl,
  isBoosted: j.isBoosted,
  summary: j.summary,
  postType: j.postType,
  postText: j.postText,
  postHandle: j.postHandle,
  postVerified: j.postVerified,
}));
---

<BaseLayout
  title="Vacancy.Design — Design Jobs & Remote Design Vacancies"
  description="Free curated design jobs — product design, UI/UX, motion, brand & remote vacancies worldwide. Lowongan kerja desainer, loker desainer remote, info loker desain. No sign-up, no noise."
  jobCount={jobCount}
  currentPath="/"
  breadcrumb="Jobs"
>
  <div
    class="flex h-full"
    x-data={`{ jobs: ${JSON.stringify(jobsData)}, selectedIndex: 0 }`}
  >
    <!-- Job list -->
    <div class="flex-[56] overflow-y-auto bg-white md:bg-[#f9f9f9]">
      {jobs.length === 0 ? (
        <div class="flex items-center justify-center h-64 text-[13px] text-[#888888]">
          No active listings right now. Check back soon.
        </div>
      ) : (
        <ul>
          {jobs.map((job, i) => (
            <li>
              <JobListItem job={job} index={i} />
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Detail panel (desktop only) -->
    <JobDetailPanel />
  </div>
</BaseLayout>
