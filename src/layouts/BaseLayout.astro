---
import NavSidebar from '../components/NavSidebar.astro';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
  jobCount?: number;
  currentPath?: string;
  schema?: object;
  breadcrumb?: string;
}

const {
  title = 'Vacancy.Design — Curated Design Jobs',
  description = 'Free curated design jobs — product design, UI/UX, motion, brand & remote vacancies. Lowongan kerja desainer, loker remote, info loker desain. No sign-up.',
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
  jobCount = 0,
  currentPath = '/',
  schema,
  breadcrumb,
} = Astro.props;

const resolvedCanonical = canonical ?? `https://vacancy.design${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={ogUrl ?? resolvedCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://vacancy.design/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://vacancy.design/og-image.jpg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@700&display=swap" rel="stylesheet" />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>
  <body class="bg-white text-[#111111] font-sans antialiased h-screen overflow-hidden flex flex-col">
    <!-- Cross-promo banner -->
    <a
      href="https://tryresumebuilder.com"
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 flex items-center justify-center gap-2 bg-[#111111] text-white text-[12px] md:text-[13px] font-medium text-center px-4 py-[9px] hover:bg-black transition-colors"
    >
      <span>Boost your resume quality with our FREE resume builder <span class="font-semibold underline underline-offset-2">ResumeLite</span></span>
      <span aria-hidden="true">→</span>
    </a>

    <!-- Desktop header -->
    <header class="hidden md:flex h-[80px] shrink-0 border-b border-[#dcdcdc] items-center gap-3 px-[80px]">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.svg" alt="Vacancy.Design" width="29" height="32" />
        <span class="font-manrope font-bold text-[20px] text-black">VacancyDesign</span>
      </a>
      {breadcrumb && (
        <>
          <span class="font-manrope font-bold text-[20px] text-black opacity-40">{'>'}</span>
          <span class="font-manrope font-bold text-[20px] text-black">{breadcrumb}</span>
        </>
      )}
    </header>

    <!-- Body row -->
    <div class="flex flex-col md:flex-row flex-1 overflow-hidden min-h-0">
      <NavSidebar currentPath={currentPath} jobCount={jobCount} breadcrumb={breadcrumb} />
      <main class="flex-1 min-w-0 overflow-hidden relative">
        <slot />
        {currentPath !== '/' && (
          <img
            src="/logo-accent.svg"
            alt=""
            aria-hidden="true"
            class="fixed bottom-0 right-0 w-[672px] pointer-events-none select-none"
            style="z-index: 0"
          />
        )}
      </main>
    </div>
  </body>
</html>
