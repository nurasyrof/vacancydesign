---
interface Props {
  variant: 'light' | 'dark';
  title: string;
  body: string;
  features?: string[];
  ctaLabel: string;
  ctaHref?: string;
  ctaDisabled?: boolean;
  ctaNote?: string;
}

const {
  variant,
  title,
  body,
  features,
  ctaLabel,
  ctaHref,
  ctaDisabled = false,
  ctaNote,
} = Astro.props;

const isDark = variant === 'dark';
---

<div class={`rounded-2xl p-8 flex flex-col gap-6 ${isDark ? 'bg-[#1A1A1A] text-white' : 'bg-white border border-[#E5E5E5] text-[#111111]'}`}>
  <div>
    <h3 class={`text-[18px] font-semibold mb-3 ${isDark ? 'text-white' : 'text-[#111111]'}`}>{title}</h3>
    <p class={`text-[15px] leading-[1.6] ${isDark ? 'text-[#AAAAAA]' : 'text-[#888888]'}`}>{body}</p>
  </div>

  {features && features.length > 0 && (
    <ul class="flex flex-col gap-2">
      {features.map(f => (
        <li class={`flex items-start gap-2 text-[14px] ${isDark ? 'text-[#CCCCCC]' : 'text-[#888888]'}`}>
          <svg class="mt-0.5 shrink-0" width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M2 7l4 4 6-6" stroke={isDark ? '#CCCCCC' : '#888888'} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {f}
        </li>
      ))}
    </ul>
  )}

  <div>
    {ctaDisabled ? (
      <div class="flex items-center gap-3">
        <button
          type="button"
          disabled
          class={`px-5 py-2.5 rounded-full text-[14px] font-medium cursor-not-allowed opacity-50 ${isDark ? 'bg-white text-[#111111]' : 'bg-[#111111] text-white'}`}
        >
          {ctaLabel}
        </button>
        {ctaNote && <span class={`text-[13px] ${isDark ? 'text-[#888888]' : 'text-[#888888]'}`}>{ctaNote}</span>}
      </div>
    ) : (
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class={`inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-[14px] font-medium transition-colors ${isDark ? 'bg-white text-[#111111] hover:bg-[#F0F0F0]' : 'bg-[#111111] text-white hover:bg-[#333333]'}`}
      >
        {ctaLabel} ↗
      </a>
    )}
  </div>
</div>
